// lsass_dump_file_created.yml - Microsoft Defender XDR / Sentinel (generated by tools/convert.py)
DeviceFileEvents
| where (FolderPath contains "lsass" and FolderPath endswith ".dmp") and (not((InitiatingProcessFolderPath endswith "\\WerFault.exe" and FolderPath startswith "C:\\ProgramData\\Microsoft\\Windows\\WER\\")))
